// SDMeet 2.0. Tables are prefixed sd_ so they live next to the v1 tables
// without touching them. Keep prisma/migrate.js in sync with this file
// (npm test checks it with `prisma migrate diff`).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Room {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime
  // playing (stages 1-3) | reveal | archived (purged, capsule only)
  status             String    @default("playing")
  decks              String[]
  // creator picked the 18+ deck; it stays only if the partner opts in too
  adultPending       Boolean   @default(false)
  turnSeat           Int       @default(1)
  // encrypted card metadata, built when the reveal starts
  board              String?
  revealAt           DateTime?
  shareConsent       Int[]     @default([])
  exportConsent      Int[]     @default([])
  adultExportConsent Int[]     @default([])

  players  Player[]
  answers  Answer[]
  asked    Asked[]
  cards    CardState[]
  messages Message[]
  voices   Voice[]
  capsule  Capsule?

  @@index([expiresAt])
  @@map("sd_rooms")
}

model Player {
  id             String    @id @default(uuid())
  roomId         String
  seat           Int
  name           String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  stage1At       DateTime?
  stage2At       DateTime?
  stage3At       DateTime?
  // first guess saved: the partner's stage-1 answers are frozen from here on
  guessStartedAt DateTime?
  retakeAt       DateTime?
  retakeGuessAt  DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, seat])
  @@map("sd_players")
}

model Answer {
  id        String   @id @default(uuid())
  roomId    String
  playerId  String
  // self | guess | reply | retake | retake_guess
  kind      String
  // "<deckId>:<questionId>" or an Asked id for replies
  qkey      String
  // encrypted { v, pass, label }
  data      String
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([playerId, kind, qkey])
  @@index([roomId])
  @@map("sd_answers")
}

model Asked {
  id       String  @id @default(uuid())
  roomId   String
  fromSeat Int
  deckId   String?
  poolId   String?
  // encrypted custom question text
  custom   String?
  lock     Boolean @default(false)
  position Int

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("sd_asked")
}

model CardState {
  id        String    @id @default(uuid())
  roomId    String
  key       String
  position  Int
  openedAt  DateTime?
  openedBy  Int?
  lockSeats Int[]     @default([])
  // discussed | later | rule
  status    String?
  // encrypted rule text
  rule      String?
  updatedAt DateTime  @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, key])
  @@map("sd_cards")
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  cardKey   String
  seat      Int
  // encrypted text
  body      String?
  voiceId   String?
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, cardKey])
  @@map("sd_messages")
}

model Voice {
  id         String   @id @default(uuid())
  roomId     String
  playerId   String
  // the reveal card this clip belongs to (partner access is gated on it)
  cardKey    String?
  mime       String
  durationMs Int
  // encrypted audio
  data       Bytes
  createdAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("sd_voices")
}

model Capsule {
  id         String    @id @default(uuid())
  roomId     String    @unique
  createdAt  DateTime  @default(now())
  // encrypted { answers: { promptId: text } }
  entry1     String?
  entry2     String?
  months1    Int?
  months2    Int?
  sealedAt   DateTime?
  openAt     DateTime?
  // encrypted copy of stage-1 answers and guesses at sealing time
  snapshot   String?
  retakeDeck String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("sd_capsules")
}

// App settings, e.g. the generated encryption key when DATA_KEY isn't set.
model Setting {
  key   String @id
  value String

  @@map("sd_settings")
}
