DATABASE_URL=postgresql://user:password@localhost:5432/sdmeet
PORT=3000
# 32 random bytes, base64. Required in production. Generate: openssl rand -base64 32
# Never change it on a live deployment: existing answers become unreadable.
DATA_KEY=
# Days a room is kept after its last activity (default 30)
ROOM_TTL_DAYS=30
# Set to "minutes" to make capsule durations minutes instead of months (testing only)
CAPSULE_UNIT=
